{
  "//": "DEVELOPMENT ONLY. These values exist so `docker compose up` works out of the box. They must never be reused for any real deployment.",
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=ServiceManagement;User Id=sa;Pwd=YourStrong!Passw0rd;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ServiceManagement.Api",
    "Audience": "ServiceManagement.Clients",
    "SigningKey": "dev-only-signing-key-please-replace-in-production-1234567890",
    "AccessTokenMinutes": 30
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "Enabled": true,
    "DefaultTtlMinutes": 5
  },
  "Database": {
    "EnableSensitiveDataLogging": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  }
}
