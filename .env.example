# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values.
#
#   cp .env.example .env
#
# `.env` is git-ignored: never commit real credentials.
# The defaults below are intended for a throw-away local development stack.
# ---------------------------------------------------------------------------

# SQL Server (docker compose service: sqlserver)
# Must satisfy the SQL Server password policy: 8+ characters with upper case,
# lower case, a digit and a symbol.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
MSSQL_PORT=1433

# Redis (docker compose service: redis)
REDIS_PORT=6379

# API
API_PORT=8080

# JWT signing key for the API container. At least 32 characters; replace it with
# a real random value for anything other than the local development stack, for
# example with:  openssl rand -base64 48
# The double-underscore form is the ASP.NET Core configuration key for Jwt:SigningKey.
Jwt__SigningKey=dev-only-signing-key-please-replace-in-production-1234567890
