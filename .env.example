# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values.
#
#   cp .env.example .env
#
# `.env` is git-ignored: never commit real credentials.
# The defaults below are intended for a throw-away local development stack.
# ---------------------------------------------------------------------------

# SQL Server (docker compose service: sqlserver)
# Must satisfy the SQL Server password policy: 8+ characters with upper case,
# lower case, a digit and a symbol.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
MSSQL_PORT=1433

# Redis (docker compose service: redis)
# The development stack runs Redis without a password and exposes it on the host
# for debugging. The production overlay (docker-compose.prod.yml) closes the host
# port and requires this password - the stack refuses to start without it.
REDIS_PORT=6379
REDIS_PASSWORD=

# API
API_PORT=8080

# JWT signing key for the API container. At least 32 characters; replace it with
# a real random value for anything other than the local development stack, for
# example with:  openssl rand -base64 48
# The double-underscore form is the ASP.NET Core configuration key for Jwt:SigningKey.
#
# Startup FAILS while this is still the value from appsettings.json, and a
# production deployment FAILS while this is still the development key below -
# both would let anyone with repository access forge tokens with every
# permission, so the API refuses to start instead.
Jwt__SigningKey=dev-only-signing-key-please-replace-in-production-1234567890

# Real e-mail delivery for notifications (optional). The development stack leaves
# this off: notifications are stored in the database and the e-mail channel only
# logs. To deliver mail, set Notifications__EmailEnabled=true and provide:
#   Notifications__Smtp__Host=smtp.example.com
#   Notifications__Smtp__Port=587
#   Notifications__Smtp__FromAddress=service-desk@example.com
#   Notifications__Smtp__UserName=service-desk@example.com
#   Notifications__Smtp__Password=<mailbox password>

# Observability (optional). When set, the API exports traces and metrics over
# OTLP (gRPC) - point it at an OpenTelemetry Collector or a vendor agent.
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317

# Behind a reverse proxy or load balancer, enable forwarded headers so rate
# limiting and the audit trail see the real client address. List the proxy:
#   Proxy__Enabled=true
#   Proxy__KnownProxies__0=10.0.0.5
# Leave disabled for a direct-to-internet deployment: a client could otherwise
# forge X-Forwarded-For and escape the login rate limit.
