{
  "ConnectionStrings": {
    "//": "No credential is committed here on purpose: configure ConnectionStrings__Default through user secrets or an environment variable, or use docker compose with the .env file.",
    "Default": "Server=localhost,1433;Database=ServiceManagement;User Id=sa;Pwd=<configure-via-user-secrets-or-environment>;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ServiceManagement.Api",
    "Audience": "ServiceManagement.Clients",
    "SigningKey": "__SET_VIA_USER_SECRETS_OR_ENV__MIN_32_CHARACTERS__",
    "AccessTokenMinutes": 30
  },
  "Auth": {
    "RefreshTokenDays": 7,
    "MaxRefreshTokensPerUser": 10
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "Enabled": true,
    "DefaultTtlMinutes": 10
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "ApplyMigrationsOnStartup": true
  },
  "Sla": {
    "FallbackFirstResponseMinutes": 120,
    "FallbackResolutionMinutes": 1440,
    "AtRiskThresholdPercent": 20
  },
  "BackgroundJobs": {
    "Enabled": true,
    "SlaScanIntervalMinutes": 5,
    "RefreshTokenCleanupIntervalMinutes": 60
  },
  "Notifications": {
    "EmailEnabled": false,
    "ReadNotificationRetentionDays": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Proxy": {
    "//": "Enable only when the API sits behind a reverse proxy or load balancer, and list that proxy in KnownProxies/KnownNetworks. Without this, rate limiting and audit records see the proxy address instead of the client.",
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "TrustAllForwardedHeaders": false,
    "ForwardLimit": 1
  },
  "AllowedHosts": "*"
}
